<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:aftertime="https://aftertime.local/bpmn" id="Definitions_example-order" targetNamespace="https://aftertime.local/bpmn"><bpmn:message id="Message_order.received" name="order.received" /><bpmn:process id="example-order" aftertime:testBinding="example-order" name="Приклад: замовлення" isExecutable="true"><bpmn:startEvent id="start" name="Надійшло замовлення" aftertime:eventRef="order.received"><bpmn:messageEventDefinition id="Definition_start" messageRef="Message_order.received"></bpmn:messageEventDefinition></bpmn:startEvent><bpmn:userTask id="order" aftertime:testPhase="order" name="Оформити замовлення"></bpmn:userTask><bpmn:userTask id="issue" aftertime:testPhase="issue" name="Видати товар"></bpmn:userTask><bpmn:userTask id="return" aftertime:testPhase="return" name="Прийняти повернення"></bpmn:userTask><bpmn:endEvent id="end" name="Замовлення закрито"></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="order"></bpmn:sequenceFlow><bpmn:sequenceFlow id="f2" sourceRef="order" targetRef="issue"></bpmn:sequenceFlow><bpmn:sequenceFlow id="f3" sourceRef="issue" targetRef="return"></bpmn:sequenceFlow><bpmn:sequenceFlow id="f4" sourceRef="return" targetRef="end"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="Diagram_example-order"><bpmndi:BPMNPlane id="Plane_example-order" bpmnElement="example-order"><bpmndi:BPMNShape id="Shape_start" bpmnElement="start"><dc:Bounds x="80" y="120" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_order" bpmnElement="order"><dc:Bounds x="240" y="120" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_issue" bpmnElement="issue"><dc:Bounds x="420" y="120" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_return" bpmnElement="return"><dc:Bounds x="600" y="120" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_end" bpmnElement="end"><dc:Bounds x="780" y="120" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1"><di:waypoint x="116" y="138" /><di:waypoint x="240" y="160" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2"><di:waypoint x="390" y="160" /><di:waypoint x="420" y="160" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_f3" bpmnElement="f3"><di:waypoint x="570" y="160" /><di:waypoint x="600" y="160" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_f4" bpmnElement="f4"><di:waypoint x="750" y="160" /><di:waypoint x="780" y="138" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>